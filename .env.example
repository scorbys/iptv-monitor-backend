PUBLIC_BASE_URL="https://your-domain-url.com"
BASE_URL="https://your-domain-url.com"
INTERNAL_API_URL="https://your-domain-url.com"
# Optional: shared secret for /api/internal/* server-to-server calls.
# If left unset, it is derived automatically from JWT_SECRET (no action needed).
INTERNAL_API_SECRET=""
COOKIE_DOMAIN=""
FRONTEND_URL="https://your-domain-url.com"
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
JWT_SECRET="your-very-secure-random-jwt-secret-key-here"
MONGO_URL="mongodb+srv://USERNAME:PASSWORD@cluster0.wnmnw.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
NODE_ENV="production"
PORT="3001"
TELEGRAM_BOT_TOKEN="your-bot-token-here"
ML_SERVICE_URL="https://your-domain-url.com"
ML_SERVICE_TIMEOUT="60000"

# ==================== AVATAR UPLOAD STORAGE ====================
# Optional. Required only if local users are allowed to upload profile photos.
# Store uploaded image files in Cloudinary; MongoDB stores only the resulting URL.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ==================== OPTIONAL SUPABASE MIRROR ====================
# Optional legacy mirror only. MongoDB Atlas remains the source of truth.
# Do not rely on Supabase free tier as the production backup database.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"
# Optional: Service role key (untuk admin operations)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ==================== SYNC CONFIGURATION ====================
ENABLE_SUPABASE_SYNC=false
SYNC_STRATEGY="manual"  # Options: real-time, periodic, manual
SYNC_INTERVAL=5000  # milliseconds (if periodic)
ENABLE_TWO_WAY_SYNC=false

# ==================== SECURITY NOTES ====================
# 1. Never commit .env files to git
# 2. Use strong random values for secrets
# 3. Rotate credentials periodically
# 4. Use different values for production/development
# 5. Set IP whitelist in MongoDB Atlas
